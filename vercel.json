{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/produit-og?type=produit&id=:id"
    },
    {
      "source": "/f/:id",
      "destination": "/api/produit-og?type=formation&id=:id"
    },
    {
      "source": "/s/:id",
      "destination": "/api/produit-og?type=serigraphie&id=:id"
    },
    {
      "source": "/e/:slug",
      "destination": "/api/produit-og?type=entreprise&slug=:slug"
    },
    {
      "source": "/r/:id",
      "destination": "/api/produit-og?type=salon&id=:id"
    },
    {
      "source": "/verify/:code",
      "destination": "/verify.html?code=:code"
    },
    {
      "source": "/m/:adresse",
      "destination": "/api/produit-og?type=profil&adresse=:adresse"
    },
    {
      "source": "/pro",
      "destination": "/pro.html"
    },
    {
      "source": "/regles-pages-publiques",
