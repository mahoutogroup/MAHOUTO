      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "fichier",
          "accept": [
            "image/*",
            "video/*",
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/zip"
          ]
        }
      ]
    }
  },

  "screenshots": [],

  "prefer_related_applications": false
