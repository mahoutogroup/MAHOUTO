  "screenshots": [
    {
      "src": "/assets/screenshot-accueil.jpg",
      "sizes": "1080x2340",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Écran d'accueil de MAHOUTO+"
    },
    {
      "src": "/assets/screenshot-messages.jpg",
      "sizes": "1080x2340",
      "type": "image/jpeg",
      "form_factor": "narrow",
