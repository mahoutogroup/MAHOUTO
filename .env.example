# =========================================================
# MAHOUTO+ — Variables d'Environnement
# Copie ce fichier en .env.local et remplis les valeurs réelles
# NE JAMAIS committer .env.local sur GitHub
# =========================================================

# ---- SUPABASE ----
# Où trouver: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- FEDAPAY (Paiements) ----
# Où trouver: FedaPay Dashboard > API Keys
FEDAPAY_PUBLIC_KEY=your-public-key-here
FEDAPAY_SECRET_KEY=your-secret-key-here
FEDAPAY_WEBHOOK_SECRET=your-webhook-secret-here
FEDAPAY_ENVIRONMENT=sandbox
# Changez en "live" pour la production

# ---- CLOUDINARY (Stockage d'images/vidéos) ----
# Où trouver: Cloudinary Dashboard > Settings > API
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- GOOGLE OAUTH ----
# Où trouver: Google Cloud Console > Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- OPENROUTER (IA - Chat, Traduction, Programmation) ----
# Où trouver: OpenRouter Dashboard > API Keys
# Note: Les utilisateurs fourniront leur propre clé dans l'app
OPENROUTER_API_KEY=your-api-key-here

# ---- VERCEL ----
# URL publique de l'application (utilisée pour les callbacks)
PUBLIC_SITE_URL=https://mahouto.vercel.app
# Ou en développement local:
# PUBLIC_SITE_URL=http://localhost:3000

# ---- DÉVELOPPEMENT ----
# Défini automatiquement par Vercel en production
NODE_ENV=development
